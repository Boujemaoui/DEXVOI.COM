# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RESEND_API_KEY: Clave de API de Resend (resend.com) para enviar notificaciones automáticas por email cuando un cliente pide auditoría o contacto.
RESEND_API_KEY=

# NOTIFICATION_EMAIL: Correo donde recibirás los leads y solicitudes de auditoría
NOTIFICATION_EMAIL=saidsahar2013@gmail.com

# STRIPE_SECRET_KEY: Clave secreta o restringida de Stripe (sk_live_... o rk_live_...)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: (Opcional) Firma de webhook para automatizar entregas de pedidos
STRIPE_WEBHOOK_SECRET=

# VITE_GA_MEASUREMENT_ID: ID de medición de Google Analytics 4 (ejemplo: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

