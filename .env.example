# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NOTIFICATION_EMAIL: Correo oficial donde se recibirán todos los leads, auditorías y formularios
NOTIFICATION_EMAIL=info@dexvoi.com

# BREVO (Sistema exclusivo principal de envío transaccional de leads y confirmaciones)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@dexvoi.com
BREVO_SENDER_NAME="Dexvoi"

# Nota: Cloudflare Email Workers queda en pausa hasta contratar el plan de pago ($5/mes).

# RESEND_API_KEY: (Opcional) Clave de API de Resend como proveedor alternativo
RESEND_API_KEY=

# STRIPE_SECRET_KEY: Clave secreta o restringida de Stripe (sk_live_... o rk_live_...)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: (Opcional) Firma de webhook para automatizar entregas de pedidos
STRIPE_WEBHOOK_SECRET=

# VITE_GA_MEASUREMENT_ID: ID de medición de Google Analytics 4 (ejemplo: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# PAGESPEED_API_KEY: (Opcional) Clave de API de Google PageSpeed Insights para métricas de rendimiento en laboratorio
PAGESPEED_API_KEY=

